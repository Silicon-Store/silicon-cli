  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Silicon-Store/silicon-cli",
  "repository": { "type": "git", "url": "git+https://github.com/Silicon-Store/silicon-cli.git" },
  "bugs": { "url": "https://github.com/Silicon-Store/silicon-cli/issues" },
  "bin": {
    "silicon": "dist/index.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
